# Database mode: false uses local db.sqlite3; true uses PostgreSQL.
# USE_POSTGRESS is also accepted for compatibility with the existing spelling.
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/riwaaya

# Used when DATABASE_URL is not supplied and USE_POSTGRES=true.
POSTGRES_DB=riwaaya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Configure an S3-compatible bucket for uploaded media.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_LOCATION=media
# Optional for S3-compatible providers such as MinIO or LocalStack.
AWS_S3_ENDPOINT_URL=